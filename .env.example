# Core portfolio metadata. Replace only when a production origin is confirmed.
# Only http(s) origins are accepted; missing/invalid values fall back to localhost.
DOMAIN=http://localhost:3000
# Empty for localhost/root hosting; /portfolio-v1 for the current project Pages URL.
# GitHub Actions derives DOMAIN and this path from actions/configure-pages.
NEXT_PUBLIC_BASE_PATH=

# Archived integrations: NOT required or enabled on GitHub Pages.
# These variables do not populate the local Projects/Achievements content.

# Dashboard
# GITHUB_READ_USER_TOKEN_PERSONAL=
# WAKATIME_API_KEY=
# CODEWARS_USER_ID=
# MONKEYTYPE_API_KEY=
# UMAMI_API_KEY=
# UMAMI_WEBSITE_ID_MYID=
# UMAMI_WEBSITE_ID_SITE=

# Chat authentication (configure actual providers before enabling sign-in)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
# NEXT_PUBLIC_AUTHOR_EMAIL=

# Retained Supabase clients
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Retained email endpoints; main Contact page uses direct links instead
# NODEMAILER_EMAIL=
# NODEMAILER_PW=

# Retained Firebase client
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# NEXT_PUBLIC_FIREBASE_DB_URL=

# Retained TikTok service
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
